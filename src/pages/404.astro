---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pairs } from '../data/pairs';

const featured = pairs.slice(0, 12);
---

<BaseLayout
  title="Page not found | Timezone Prime"
  description="This page does not exist. Use the time zone converter or pick a popular conversion."
  noindex
>
  <div class="container-page pt-16 sm:pt-24">
    <p class="font-mono text-sm text-muted">Error 404</p>
    <h1 class="mt-2 text-[2.25rem] leading-[1.05] tracking-[-0.045em] sm:text-display">This page does not exist</h1>
    <p class="mt-4 text-lg">The link may be old or mistyped. The converter handles any pair of zones.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Open the converter</a>
      <a href="/faq/" class="btn">Read the FAQ</a>
    </div>
    <h2 class="mt-12 text-sm font-medium text-muted">Popular conversions</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        featured.map((p) => (
          <li>
            <a href={`/${p.slug}/`} class="chip">
              {p.from.abbr} to {p.to.abbr}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
