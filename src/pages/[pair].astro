---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import WorldMap from '../components/WorldMap.astro';
import HourTable from '../components/HourTable.astro';
import { pairs, pairPath, type Pair } from '../data/pairs';
import { offsetsSummary, periodLabel } from '../lib/pair-content';
import { aliasText, pairPageData, zoneLabel } from '../lib/pair-page';
import { formatDurationShort } from '../lib/time';
import { allPairKeywords, pairMetaKeywords } from '../lib/seo';

export const getStaticPaths = (() => pairs.map((p) => ({ params: { pair: p.slug }, props: { pair: p } }))) satisfies GetStaticPaths;

interface Props {
  pair: Pair;
}

const { pair } = Astro.props;
const { from: A, to: B } = pair;
const site = 'https://timezoneprime.com';

const label = zoneLabel;
const now = Date.now();
const {
  seo,
  year,
  twoYearPeriods,
  tableGroups,
  daysText,
  differenceSummary,
  times,
  quick,
  changes,
  dstSummary,
  meetingText,
  title,
  description,
  faqs,
  citySample,
} = pairPageData(pair, now);
const keywords = seo ? pairMetaKeywords(seo.keywords) : [];

const reverse = pairPath(B, A);
const sameSource = pairs.filter((p) => p.from.slug === A.slug && p.slug !== pair.slug);
const sameTarget = pairs.filter((p) => p.to.slug === B.slug && p.slug !== pair.slug && p.from.slug !== B.slug);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Time zone converter', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: `${label(A)} to ${label(B)}`, item: `${site}/${pair.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${label(A)} to ${label(B)} converter`,
    url: `${site}/${pair.slug}/`,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
    ...(seo && {
      alternateName: seo.keywords.aliases
        .filter((k) => !k.endsWith('converter'))
        .map((k) => `${k.split(' to ').map((s) => s.toUpperCase()).join(' to ')} converter`),
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: `${site}/${pair.slug}/`,
    description,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Timezone Prime', url: `${site}/` },
    about: [A, B].map((z) => ({ '@type': 'Thing', name: z.name, alternateName: aliasText(z) })),
    ...(seo && { keywords: allPairKeywords(seo.keywords).join(', ') }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} keywords={keywords}>
  <div class="hero-ground">
  <div class="container-page pt-4 sm:pt-10">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-ink hover:underline">Converter</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${pair.slug}/`} aria-current="page" class="text-ink">{label(A)} to {label(B)}</a></li>
      </ol>
    </nav>
    <div class="mt-3 max-w-3xl sm:mt-5">
      <h1 id="converter-heading" class="text-[1.875rem] leading-[1.05] tracking-[-0.035em] sm:text-display">
        {label(A)} to {label(B)} converter
      </h1>
      <p class="mt-2 text-[0.9375rem] sm:mt-4 sm:text-lg">
        Convert {A.name} ({aliasText(A)}) to {B.name} ({aliasText(B)}), with daylight saving applied for the exact date you pick.
      </p>
    </div>
    <div class="mt-5 sm:mt-8">
      <Converter from={A.tz} to={B.tz} headingId="converter-heading" />
    </div>
  </div>
  </div>
  <div class="container-page">

    <dl class="mt-10 grid gap-x-10 gap-y-6 border-t border-rule pt-8 md:grid-cols-3">
      <div>
        <dt class="text-sm text-muted">Time difference</dt>
        <dd class="mt-1.5 text-[0.9375rem] text-ink">{differenceSummary}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">Meeting window</dt>
        <dd class="mt-1.5 text-[0.9375rem] text-ink">{meetingText}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">Daylight saving</dt>
        <dd class="mt-1.5 text-[0.9375rem] text-ink">{dstSummary}</dd>
      </div>
    </dl>
    {
      citySample.length > 0 && (
        <p class="mt-6 text-[0.9375rem]">
          The same conversion works for every city on these clocks, such as {citySample.map((c, i) => `${c.from} to ${c.to}${i < citySample.length - 2 ? ', ' : i === citySample.length - 2 ? ' and ' : ''}`)}.
        </p>
      )
    }
  </div>

  <WorldMap from={A.tz} to={B.tz} heading={`Where ${label(A)} and ${label(B)} apply`} />
  <HourTable from={A.tz} to={B.tz} />

  <section class="container-page mt-24 sm:mt-32" aria-labelledby="reference-heading">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <div>
        <h2 id="reference-heading" class="text-heading">{label(A)} to {label(B)} conversion table</h2>
        <p class="mt-3 text-[0.9375rem]">
          {times.length ? `Every hour of the ${A.name} day, plus the common half hours,` : `Common ${label(A)} times`} and their {label(B)} equivalents.
          {tableGroups.length > 1 && ' The second column covers the part of the year when the clocks are on a different gap.'}
        </p>
      </div>
      <div class="panel overflow-x-auto">
        <table class="data-table">
          <caption class="sr-only">{label(A)} to {label(B)} conversion table</caption>
          <thead>
            <tr>
              <th scope="col">{A.name}</th>
              {
                tableGroups.map((g) => (
                  <th scope="col">
                    <span class="block text-ink">{g.toAbbrs.join(' or ')}</span>
                    <span class="block text-xs font-normal">
                      {formatDurationShort(g.diff)} {g.diff >= 0 ? 'ahead' : 'behind'}, {daysText(g.days)}
                    </span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              quick.map((r) => (
                <tr>
                  <td class="font-medium">{r.from}</td>
                  {r.to.map((t) => (
                    <td>{t}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {
    twoYearPeriods.length > 1 && (
      <section class="container-page mt-24 sm:mt-32" aria-labelledby="periods-heading">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
          <div>
            <h2 id="periods-heading" class="text-heading">
              How the gap changes in {year} and {year + 1}
            </h2>
            <p class="mt-3 text-[0.9375rem]">Each row is a stretch of days with one constant difference, split at every clock change.</p>
          </div>
          <div class="panel overflow-x-auto">
            <table class="data-table min-w-[34rem]">
              <caption class="sr-only">
                Time difference periods between {label(A)} and {label(B)}
              </caption>
              <thead>
                <tr>
                  <th scope="col">Dates</th>
                  <th scope="col">{label(A)}</th>
                  <th scope="col">{label(B)}</th>
                  <th scope="col">Difference</th>
                </tr>
              </thead>
              <tbody>
                {twoYearPeriods.map((p) => (
                  <tr>
                    <td>{periodLabel(p)}</td>
                    <td>{p.fromAbbr}</td>
                    <td>{p.toAbbr}</td>
                    <td>
                      {p.diff === 0 ? 'Same time' : `${p.toAbbr} ${formatDurationShort(p.diff)} ${p.diff > 0 ? 'ahead' : 'behind'}`}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  <section class="container-page mt-24 sm:mt-32" aria-labelledby="changes-heading">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <h2 id="changes-heading" class="text-heading">Upcoming clock changes</h2>
      {
        changes.length ? (
          <ol class="grid gap-3">
            {changes.map((c) => (
              <li class="grid gap-1 border-b border-rule-2 pb-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
                <span class="text-sm text-muted">{c.zone.name}</span>
                <span class="text-[0.9375rem] text-ink">{c.text}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="text-[0.9375rem]">
            Neither {A.name} nor {B.name} changes its clocks in the next 18 months.
          </p>
        )
      }
    </div>
  </section>

  <section class="container-page mt-24 sm:mt-32" aria-labelledby="zones-heading">
    <h2 id="zones-heading" class="text-heading">About the two zones</h2>
    <div class="mt-8 grid gap-10 md:grid-cols-2">
      {
        [A, B].map((z) => (
          <article class="border-t border-rule pt-6">
            <h3 class="text-title">
              {z.name} <span class="font-normal text-muted">({z.dstAbbr ? `${z.stdAbbr} / ${z.dstAbbr}` : z.stdAbbr})</span>
            </h3>
            <p class="mt-3 text-[0.9375rem]">{z.about}</p>
            <dl class="mt-5 grid grid-cols-[7rem_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
              <dt class="text-muted">IANA zone</dt>
              <dd class="font-mono text-[0.8125rem] text-ink">{z.tz}</dd>
              <dt class="text-muted">Offset</dt>
              <dd class="text-ink">{offsetsSummary(z, now)}</dd>
              <dt class="text-muted">Used in</dt>
              <dd class="text-ink">{z.places}</dd>
              {z.cities.length > 0 && (
                <>
                  <dt class="text-muted">Major cities</dt>
                  <dd class="text-ink">{z.cities.join(', ')}</dd>
                </>
              )}
            </dl>
            {z.note && <p class="mt-4 text-sm">{z.note}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-24 sm:mt-32" aria-labelledby="faq-heading">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <h2 id="faq-heading" class="text-heading">{label(A)} and {label(B)}, answered</h2>
      <div class="grid gap-6">
        {
          faqs.map((f) => (
            <div class="border-b border-rule-2 pb-6">
              <h3 class="font-medium">{f.q}</h3>
              <p class="mt-2 text-[0.9375rem]">{f.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page mt-24 sm:mt-32" aria-labelledby="related-heading">
    <h2 id="related-heading" class="text-heading">Related conversions</h2>
    <div class="mt-8 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-medium text-muted">From {A.name}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            reverse && (
              <li>
                <a href={reverse} class="chip border-ink">
                  {label(B)} to {label(A)}
                </a>
              </li>
            )
          }
          {
            sameSource.map((p) => (
              <li>
                <a href={`/${p.slug}/`} class="chip">
                  {label(p.from)} to {label(p.to)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        sameTarget.length > 0 && (
          <div>
            <h3 class="text-sm font-medium text-muted">To {B.name}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {sameTarget.map((p) => (
                <li>
                  <a href={`/${p.slug}/`} class="chip">
                    {label(p.from)} to {label(p.to)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
