---
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Converter', show: 'hidden lg:block' },
  { href: '/#directory', label: 'All conversions', show: 'hidden md:block' },
  { href: '/widgets/', label: 'Widgets' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper">
  <div class="container-page flex h-14 items-center justify-between gap-2 sm:gap-3">
    <a href="/" data-astro-reload class="flex items-center gap-2 rounded-part text-[1.0625rem] sm:text-[1.1875rem]" aria-label="TimezonePrime home">
      <Logo size={28} />
      <Wordmark class="max-[30rem]:sr-only" />
    </a>
    <div class="flex items-center sm:gap-2">
      <nav aria-label="Main">
        <ul class="flex items-center sm:gap-1">
          {
            links.map((l) => (
              <li class={l.show}>
                <a
                  href={l.href}
                  class="rounded-pill px-2 py-2 text-sm whitespace-nowrap text-muted transition-colors hover:bg-paper-3 hover:text-ink aria-[current=page]:text-ink sm:px-3"
                  aria-current={path === l.href ? 'page' : undefined}
                  data-astro-reload
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        type="button"
        class="flex min-h-10 items-center gap-2 rounded-pill pr-1 pl-2 text-sm sm:pl-3 text-muted hover:text-ink"
        aria-pressed="true"
        data-theme-toggle
      >
        <span class="hidden sm:inline">Dark</span>
        <span class="sr-only sm:hidden">Dark mode</span>
        <span class="switch" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const KEY = 'tzp:theme';
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  button?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem(KEY, root.dataset.theme);
    } catch {
      /* storage unavailable */
    }
    sync();
  });
</script>
