---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<Image
  src={logo}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  loading="eager"
  decoding="async"
  aria-hidden="true"
  class:list={['shrink-0', className]}
/>
