---
import { zoneByTz } from '../data/zones';

interface Props {
  from: string;
  to: string;
  heading?: string;
}

const { from, to, heading = 'Where each clock applies' } = Astro.props;
const label = (tz: string) => zoneByTz.get(tz)?.name ?? tz.replaceAll('_', ' ');
---

<section class="container-page mt-24 sm:mt-32" aria-labelledby="map-heading">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
    <div class="max-w-xl">
      <h2 id="map-heading" class="text-heading">{heading}</h2>
      <p class="mt-3">
        Shaded areas follow the official zone boundaries, so a country split across zones is split here too. Hover or tap a region for its
        local time.
      </p>
    </div>
    <ul class="grid gap-2 text-sm" data-map-legend>
      <li class="flex items-center gap-2.5 text-ink">
        <span class="inline-block h-2.5 w-5 rounded-pill bg-from" aria-hidden="true"></span>
        <span data-legend="from">{label(from)}</span>
      </li>
      <li class="flex items-center gap-2.5 text-ink">
        <span class="inline-block h-2.5 w-5 rounded-pill bg-to" aria-hidden="true"></span>
        <span data-legend="to">{label(to)}</span>
      </li>
      <li class="flex items-center gap-2.5 text-muted">
        <span class="inline-flex h-2.5 w-5 overflow-hidden rounded-pill" aria-hidden="true">
          <span class="w-1/2 bg-from-soft"></span><span class="w-1/2 bg-to-soft"></span>
        </span>
        Same UTC offset right now, different zone rules
      </li>
    </ul>
  </div>

  <figure class="panel relative mt-8 overflow-hidden" data-map data-from={from} data-to={to}>
    <div
      class="tz-map relative aspect-[2.1/1] w-full min-h-56 bg-sea outline-none"
      data-map-canvas
      tabindex="0"
      role="group"
      aria-label="Interactive time zone map. Plus and minus zoom, arrow keys pan, zero resets."
    >
      <p class="absolute inset-0 grid place-items-center text-sm text-muted" data-map-status></p>
    </div>

    <div class="absolute top-3 right-3 flex flex-col gap-1.5" data-map-controls hidden>
      <button type="button" class="btn btn-icon" data-zoom="in" aria-label="Zoom in">
        <svg width="16" height="16" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M3 8h10"></path></svg>
      </button>
      <button type="button" class="btn btn-icon" data-zoom="out" aria-label="Zoom out">
        <svg width="16" height="16" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10"></path></svg>
      </button>
      <button type="button" class="btn btn-icon" data-zoom="reset" aria-label="Reset map view">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
          ><path d="M3 8a5 5 0 1 0 1.6-3.7M3 2.5V5h2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </button>
    </div>

    <div
      class="tz-tooltip pointer-events-none absolute top-0 left-0 z-10 hidden max-w-64 rounded-field border border-rule bg-panel px-3 py-2 text-sm shadow-float"
      data-map-tooltip
    >
    </div>

    <figcaption class="flex flex-wrap items-center justify-between gap-2 border-t border-rule px-4 py-2.5 text-xs text-muted">
      <span data-map-hint>Drag to pan. Ctrl and scroll, or pinch, to zoom.</span>
    </figcaption>
  </figure>

  <div class="panel mt-4 hidden p-4 sm:p-5" data-map-info aria-live="polite">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="min-w-0">
        <p class="font-medium text-ink" data-info-name></p>
        <p class="mt-1 text-sm tabular" data-info-time></p>
        <p class="mt-1 truncate font-mono text-xs text-muted" data-info-tz></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn btn-sm" data-info-set="from">Use as From</button>
        <button type="button" class="btn btn-sm" data-info-set="to">Use as To</button>
        <button type="button" class="btn btn-sm btn-icon size-9" data-info-close aria-label="Close region details">
          <svg width="14" height="14" viewBox="0 0 14 14" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 3 8 8M11 3l-8 8"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <noscript>
    <p class="mt-4 text-sm">The interactive map needs JavaScript.</p>
  </noscript>
</section>

<script>
  import { initMap } from '../scripts/map';
  initMap();
</script>
