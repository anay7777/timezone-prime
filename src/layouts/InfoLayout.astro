---
import BaseLayout from './BaseLayout.astro';
import { siteName, siteUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  heading: string;
  lead: string;
  /** Short name used in the breadcrumb, e.g. "About". */
  crumb: string;
  /** Page path with leading and trailing slash, e.g. "/about/". */
  path: string;
  /** ISO date shown as "Last updated" under the lead. */
  updated?: string;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage';
}

const { title, description, heading, lead, crumb, path, updated, pageType = 'WebPage' } = Astro.props;
const url = `${siteUrl}${path}`;
const updatedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Time zone converter', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: crumb, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': pageType,
    name: title,
    url,
    description,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: siteName, url: `${siteUrl}/` },
    ...(updated ? { dateModified: updated } : {}),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="hero-ground">
    <div class="container-page pt-4 pb-2 sm:pt-10">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ink hover:underline" data-astro-reload>Converter</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={path} aria-current="page" class="text-ink" data-astro-reload>{crumb}</a></li>
        </ol>
      </nav>
      <div class="mt-3 max-w-3xl sm:mt-5">
        <h1 class="text-[1.875rem] leading-[1.05] tracking-[-0.035em] sm:text-display">{heading}</h1>
        <p class="mt-2 text-[0.9375rem] sm:mt-4 sm:text-lg">{lead}</p>
        {
          updatedLabel && (
            <p class="mt-3 font-mono text-sm text-muted">
              Last updated <time datetime={updated}>{updatedLabel}</time>
            </p>
          )
        }
      </div>
    </div>
  </div>
  <div class="container-page mt-8 sm:mt-12">
    <div class="prose-page">
      <slot />
    </div>
  </div>
</BaseLayout>
