---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Wordmark from '../components/Wordmark.astro';
import { siteUrl } from '../lib/site';

interface Props {
  title: string;
  /** Size in px the widget is designed at; the whole widget scales from it to fit the iframe. */
  baseWidth: number;
  baseHeight: number;
  /** Where the credit link points, relative to the site root. */
  creditPath?: string;
  creditLabel?: string;
}

const { title, baseWidth, baseHeight, creditPath = '/', creditLabel = 'Time zone converter' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" style={`--base-w: ${baseWidth / 16}; --base-h: ${baseHeight / 16}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const t = new URLSearchParams(location.search).get('theme');
        const dark = t === 'light' ? false : t === 'auto' ? matchMedia('(prefers-color-scheme: dark)').matches : true;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <noscript><style>[data-widget] { visibility: visible !important; }</style></noscript>
  </head>
  <body class="antialiased">
    <div class="widget" data-widget>
      <div class="widget-body">
        <slot />
      </div>
      <a
        href={`${siteUrl}${creditPath}`}
        target="_blank"
        rel="noopener"
        class="widget-credit"
        data-widget-credit
      >
        <span class="flex items-center gap-1.5 text-[0.875rem]">
          <Logo size={18} class="h-[1.125rem] w-[1.125rem]" /><Wordmark />
        </span>
        <span class="truncate" data-widget-credit-label>{creditLabel} &#8599;</span>
      </a>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    background: var(--color-paper);
  }
  /* everything inside is sized in rem, so this one value scales the widget to the iframe */
  html {
    font-size: clamp(8px, min(100vw / var(--base-w), 100vh / var(--base-h)), 48px);
  }
  body {
    min-height: 0;
    font-size: 0.9375rem;
  }
  .widget {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: linear-gradient(var(--color-panel), var(--color-paper-2));
  }
  .widget:not([data-ready]) {
    visibility: hidden;
  }
  .widget-body {
    flex: 1;
    min-height: 0;
    padding: 1rem 1.125rem 0.875rem;
  }
  .widget-credit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 1.125rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-size: 0.75rem;
    transition: color 160ms var(--ease-in-out);
  }
  .widget-credit:hover {
    color: var(--color-ink);
  }
  .widget-strip {
    position: relative;
    height: 0.625rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-bed);
    background-color: var(--color-night);
  }
  .widget-now {
    position: absolute;
    top: -0.3125rem;
    bottom: -0.3125rem;
    width: 0.375rem;
    margin-left: -0.1875rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-rule-strong);
    background: var(--color-accent);
    box-shadow: var(--shadow-part);
  }
  .widget-dot {
    display: inline-block;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-night);
    box-shadow: inset 0 0 0 1px var(--color-rule-strong);
  }
  .widget-dot[data-band='work'] {
    background: var(--color-accent);
    box-shadow: none;
  }
  .widget-dot[data-band='day'] {
    background: var(--color-accent-soft);
  }
</style>
